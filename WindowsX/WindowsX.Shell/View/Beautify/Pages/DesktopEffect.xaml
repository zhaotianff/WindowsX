<Page x:Class="WindowsX.Shell.View.Beautify.Pages.DesktopEffect"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WindowsX.Shell.View.Beautify.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DesktopEffect">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="26.4"/>
        </Grid.RowDefinitions>

        <TabControl Style="{StaticResource TabControlStyle}">
            <TabItem Header="桌面动效" Style="{StaticResource StyleTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Image Name="img_background" Margin="10" Stretch="Uniform"></Image>

                    <Button Content="启动" Grid.Row="1" Width="88" Height="23" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Right" Margin="0,0,20,0"></Button>

                </Grid>
            </TabItem>
            <TabItem Header="天气特效" Style="{StaticResource StyleTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Button Content="启动" Grid.Row="1" Width="88" Height="23" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Right" Margin="0,0,20,0"></Button>

                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
