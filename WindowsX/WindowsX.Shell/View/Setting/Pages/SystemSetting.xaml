<Page x:Class="WindowsX.Shell.View.Setting.Pages.SystemSetting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="系统设置" Loaded="Page_Loaded">
    <StackPanel Margin="12">
        <Label Content="系统设置" FontSize="22" Margin="0,0,0,20"/>
        <CheckBox x:Name="check_AutoStart" Content="登录 Windows 后自动启动 WindowsX"
                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" ToolTip="仅对当前 Windows 用户生效，修改后立即保存，无需管理员权限。若已在任务管理器中禁用 WindowsX 启动项，请在任务管理器中重新启用。"
                  AutomationProperties.Name="开机自启动" Margin="5"/>
        <TextBlock x:Name="text_Error" Foreground="Crimson" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="5,12,5,0"/>
        <Button Content="刷新状态" Click="Refresh_Click" Width="88" Height="28"
                HorizontalAlignment="Left" Margin="5,16,0,0" Style="{DynamicResource ButtonStyle}"/>
    </StackPanel>
</Page>
